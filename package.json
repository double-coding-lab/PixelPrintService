{
  "name": "pixelprint-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Configurable full-stack design-to-code workspace",
  "scripts": {
    "prepare:images": "node scripts/prepare-image-compression.mjs",
    "pixelprint:update": "node scripts/update-pixelprint.mjs",
    "dev": "npm run build:web && node scripts/dev.mjs",
    "build:web": "vite build",
    "build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js --sourcemap",
    "build": "npm run build:web && npm run build:server",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "format": "prettier --write src web test",
    "format:check": "prettier --check src web test",
    "start": "node dist/index.js",
    "build:preview-browser": "node scripts/prepare-preview.mjs --browser-only",
    "prepare:preview": "node scripts/prepare-preview.mjs",
    "setup": "node scripts/setup.mjs",
    "db:init": "tsx scripts/init-database.ts",
    "content:audit": "node scripts/content-storage-audit.mjs",
    "content:migrate": "tsx scripts/migrate-content.ts",
    "checkpoint:migrate": "tsx scripts/migrate-checkpoint-content.ts",
    "check:templates": "tsx scripts/check-template-resources.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.5.3",
    "@langchain/langgraph-checkpoint": "1.2.1",
    "@langchain/openai": "1.6.2",
    "antd": "6.6.7",
    "deepagents": "1.16.0",
    "eruda": "3.4.3",
    "fastify": "^5.11.3",
    "fflate": "0.8.3",
    "js-tiktoken": "1.0.21",
    "langchain": "1.5.10",
    "langsmith": "0.9.0",
    "monaco-editor": "0.57.0",
    "mysql2": "^3.24.4",
    "prismjs": "1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sequelize": "^6.37.8",
    "typescript": "5.9.3",
    "undici": "^8.12.3",
    "zod": "^4.6.6",
    "redis": "^5.8.0",
    "pino": "^10.1.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@fastify/multipart": "^9.3.0",
    "@langchain/langgraph-sdk": "1.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prismjs": "1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2",
    "react-native": "0.83.0",
    "tsx": "^4.19.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true
  }
}
